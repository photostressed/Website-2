{
  "name": "financas",
  "productName": "Financas",
  "version": "0.2.0",
  "description": "Controlo financeiro pessoal: entradas, impostos e saídas.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "pt.photostressed.financas",
    "productName": "Financas",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Finanças"
      }
    }
  }
}
